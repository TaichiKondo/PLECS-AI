Plecs {
  Name          "pmsm_foc"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "0.25"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-05"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% PMSM vector control (id = 0). Edited by make_pmsm_"
"foc.py\n% Tune with ModelVars on the variables the blocks use directly\n% (Kp"
"_i, Ki_i, Kp_w, Ki_w, ...). Derived values are NOT recomputed.\n\n% DC link a"
"nd PWM\nVdc = 300\nfsw = 10e3\n\n% Machine (same data as the PLECS demo boost"
"ed_motor_drive)\nRs = 0.62\nLd = 4.14e-3\nLq = 4.14e-3\nphi = 0.101\npp = 4\n"
"J = 1e-3\nFv = 1e-4\nKt = 1.5*pp*phi\n\n% Current loops: PI zero cancels the "
"stator time constant\nwc_i = 2*pi*1000\nKp_i = wc_i*Lq\nKi_i = wc_i*Rs\nV_lim"
" = Vdc/2\nKbc_i = wc_i\n\n% Speed loop\nwc_w = 2*pi*50\nKp_w = wc_w*J/Kt\nKi_"
"w = Kp_w*wc_w/4\nIq_max = 10\nKbc_w = wc_w\n% Slew limit on the iq reference:"
" a step would saturate the current PI\n% and leave a slow L/R tail (see READM"
"E)\ndiq_max = 1e4\n\n% Test sequence: speed step, then load torque step\nw_re"
"f = 1000*2*pi/60\nt_w = 0.01\nT_load = 3\nt_load = 0.15"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
  MatrixSignificanceCheck "2"
  RemoveUnusedStateSpaceOutputs "2"
  EnableStateSpaceSplitting "2"
  DisplayStateSpaceSplitting "1"
  DiscretizationMethod "2"
  ExternalModeSettings ""
  AlgebraicLoopMethod "1"
  AlgebraicLoopTolerance "1e-6"
  ScriptsDialogGeometry ""
  ScriptsDialogSplitterPos "0"
  MixedSignalSolverBypassOperatingPoint "1"
  MixedSignalSolverInitialConditions "2"
  MixedSignalSolverMaxNewtonIterations "25"
  MixedSignalSolverNumThreads "-1"
  OperatingPointMaxNewtonIterations "50"
  OperatingPointRelativeNewtonTolerance "1e-3"
  OperatingPointAbsoluteNewtonTolerance "1e-12"
  OperatingPointNodalVoltageNewtonTolerance "1e-6"
  SpiceTemperature "27"
  SpiceGMin     "0"
  SpiceInductorRPar "0"
  SpiceInductorRSer "0"
  SpiceCapacitorGPar "0"
  SpiceCapacitorRSer "0"
  NetlistParserDetails "2"
  InvalidNetlistFunctionEvaluationMsg "1"
